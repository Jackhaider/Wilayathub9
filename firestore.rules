/**
 * @file Firestore Security Rules for WilayatHub
 * @version Prototyping
 *
 * @Core Philosophy:
 * This ruleset enforces a strict user-ownership model for customer and partner profiles,
 * and a shared-access model for bookings and associated chat messages.  Authorization
 * decisions are made independently at each level using denormalized data for efficiency and
 * security.
 *
 * @Data Structure:
 * - /customers/{customerId}:  Customer profile data.
 * - /partners/{partnerId}: Partner profile data.
 * - /bookings/{bookingId}: Booking data, containing denormalized customerId and partnerId.
 * - /bookings/{bookingId}/chat_messages/{messageId}: Chat messages related to a booking.
 * - /notifications/{notificationId}: Notifications for users.
 *
 * @Key Security Decisions:
 * - Users can only read/write their own customer or partner profiles.
 * - Bookings and chat messages are accessible only to the customer and partner involved,
 *   determined by the booking's customerId and partnerId, which can never be changed.
 * - Only customers create bookings, only with approved partners; each role may change only
 *   its own fields. Chat messages are sent as the signed-in user and cannot be edited or deleted.
 * - Listing of customer and partner profiles is prohibited.
 *
 * @Denormalization for Authorization:
 * - The /bookings/{bookingId} documents include the customerId and partnerId to allow
 *   authorization checks without requiring extra `get()` calls to customer or partner profiles.
 *
 * @Structural Segregation:
 * - Customer and Partner data are stored in separate collections, which simplifies access control
 *   and prevents accidental exposure of private data.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Allows a customer to read/write their own profile data.
     * @path /customers/{customerId}
     * @allow (create) request.auth.uid == 'user_abc' and request.resource.data.id == 'user_abc'
     * @allow (get, update, delete) request.auth.uid == 'user_abc'
     * @deny (create) request.auth.uid != 'user_abc'
     * @deny (get, update, delete) request.auth.uid != 'user_abc'
     * @principle Enforces document ownership for writes.
     */
    match /customers/{customerId} {
      function isOwner(userId) {
        return request.auth.uid == userId;
      }

      function isExistingOwner(userId) {
        return isOwner(userId) && resource != null;
      }

      allow get: if isOwner(customerId);
      allow list: if false;

      // A customer profile must describe the signed-in user and carry role 'customer'.
      allow create: if isOwner(customerId)
        && request.resource.data.id == customerId
        && request.resource.data.uid == customerId
        && request.resource.data.role == 'customer';
      // Identity fields (id, uid, role) can never be changed, added or removed by the user.
      allow update: if isExistingOwner(customerId)
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['id', 'uid', 'role']);
      allow delete: if isExistingOwner(customerId);
    }

    /**
     * @description Allows a partner to read/write their own profile data.
     * @path /partners/{partnerId}
     * @allow (create) request.auth.uid == 'partner_xyz' and request.resource.data.id == 'partner_xyz'
     * @allow (get, update, delete) request.auth.uid == 'partner_xyz'
     * @deny (create) request.auth.uid != 'partner_xyz'
     * @deny (get, update, delete) request.auth.uid != 'partner_xyz'
     * @principle Enforces document ownership for writes.
     */
    match /partners/{partnerId} {
      function isOwner(userId) {
        return request.auth.uid == userId;
      }

      function isExistingOwner(userId) {
        return isOwner(userId) && resource != null;
      }

      allow get: if isOwner(partnerId);
      allow list: if false;

      // A partner always starts as 'pending'. Approval (status -> 'approved') is done only by an
      // admin with privileged access (Firebase console / Admin SDK), which bypasses these rules.
      allow create: if isOwner(partnerId)
        && request.resource.data.id == partnerId
        && request.resource.data.uid == partnerId
        && request.resource.data.role == 'partner'
        && request.resource.data.status == 'pending';
      // Privileged fields (id, uid, role, status) can never be changed, added or removed by the partner.
      allow update: if isExistingOwner(partnerId)
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['id', 'uid', 'role', 'status']);
      // Admin-only (Firebase console / Admin SDK). Otherwise a rejected partner could delete their
      // profile and re-create it as 'pending', wiping the decision and any admin-set fields.
      allow delete: if false;
    }

    /**
     * @description Bookings between one customer and one approved partner.
     * @path /bookings/{bookingId}
     * @allow (get, list) the booking's customer or partner (list queries must filter on customerId or partnerId)
     * @allow (create) a customer, for themselves, with an approved partner, in status 'Requested'
     * @allow (update) the partner moves the status forward; the customer cancels or rates a completed job
     * @deny (update) anyone changing customerId, partnerId or any field outside their role
     * @deny (delete) everyone (cancel via status instead; deletion is admin-only)
     *
     * Status values (src/lib/data.ts Booking.status) and who may change them:
     *   partner:  Requested -> Active | Cancelled, Active -> On the way | Cancelled, On the way -> Completed
     *   customer: Requested -> Cancelled, Active -> Cancelled
     */
    match /bookings/{bookingId} {
      function signedIn() {
        return request.auth != null;
      }

      function isBookingCustomer() {
        return resource.data.customerId == request.auth.uid;
      }

      function isBookingPartner() {
        return resource.data.partnerId == request.auth.uid;
      }

      function partnerPath(uid) {
        return /databases/$(database)/documents/partners/$(uid);
      }

      function isApprovedPartner(uid) {
        return exists(partnerPath(uid)) && get(partnerPath(uid)).data.status == 'approved';
      }

      function hasCustomerProfile(uid) {
        return exists(/databases/$(database)/documents/customers/$(uid));
      }

      function optionalString(data, key, maxLength) {
        return !(key in data) || (data[key] is string && data[key].size() <= maxLength);
      }

      function validNewBooking(data) {
        return data.keys().hasAll(['customerId', 'partnerId', 'serviceId', 'scheduledAt', 'status', 'createdAt'])
          && data.keys().hasOnly(['customerId', 'partnerId', 'serviceId', 'scheduledAt', 'status', 'createdAt', 'address', 'notes'])
          && data.serviceId is string && data.serviceId.size() > 0 && data.serviceId.size() <= 100
          && data.scheduledAt is timestamp
          && data.createdAt == request.time
          && data.status == 'Requested'
          && optionalString(data, 'address', 500)
          && optionalString(data, 'notes', 1000);
      }

      // Only `keys` may change (customerId and partnerId are never in that list, so they are
      // immutable); an optional updatedAt must be the server time.
      function onlyChanges(keys) {
        let changed = request.resource.data.diff(resource.data).affectedKeys();
        return changed.hasOnly(keys)
          && (!('updatedAt' in changed) || request.resource.data.updatedAt == request.time);
      }

      function statusMove(from, to) {
        return resource.data.status == from && request.resource.data.status == to;
      }

      function partnerAdvancesStatus() {
        return isBookingPartner()
          && isApprovedPartner(request.auth.uid)
          && onlyChanges(['status', 'updatedAt'])
          && (statusMove('Requested', 'Active')
              || statusMove('Requested', 'Cancelled')
              || statusMove('Active', 'On the way')
              || statusMove('Active', 'Cancelled')
              || statusMove('On the way', 'Completed'));
      }

      function customerCancels() {
        return isBookingCustomer()
          && onlyChanges(['status', 'updatedAt'])
          && (statusMove('Requested', 'Cancelled') || statusMove('Active', 'Cancelled'));
      }

      // One rating per booking, by the customer, after the job is completed.
      function customerRates() {
        return isBookingCustomer()
          && resource.data.status == 'Completed'
          && !('rating' in resource.data)
          && onlyChanges(['rating', 'review', 'updatedAt'])
          && request.resource.data.rating is int
          && request.resource.data.rating >= 1
          && request.resource.data.rating <= 5
          && optionalString(request.resource.data, 'review', 1000);
      }

      allow get: if signedIn() && (isBookingCustomer() || isBookingPartner());
      allow list: if signedIn() && (isBookingCustomer() || isBookingPartner());

      allow create: if signedIn()
        && request.resource.data.customerId == request.auth.uid
        && request.resource.data.partnerId is string
        && request.resource.data.partnerId != request.auth.uid
        && hasCustomerProfile(request.auth.uid)
        && isApprovedPartner(request.resource.data.partnerId)
        && validNewBooking(request.resource.data);
      allow update: if signedIn() && (partnerAdvancesStatus() || customerCancels() || customerRates());
      allow delete: if false;
    }

    /**
     * @description Chat messages between the customer and partner of a booking.
     * @path /bookings/{bookingId}/chat_messages/{messageId}
     * @allow (get, list) the booking's customer or partner
     * @allow (create) a participant, as themselves (senderId == auth uid), while the booking is open
     * @deny (create) outsiders, impersonation, and any booking that is Completed or Cancelled
     * @deny (update, delete) everyone: messages are an immutable record of the conversation
     */
    match /bookings/{bookingId}/chat_messages/{messageId} {
      // A missing booking makes get() return null; reading .data then errors, which denies the request.
      function booking() {
        return get(/databases/$(database)/documents/bookings/$(bookingId)).data;
      }

      function isParticipant() {
        return request.auth != null
          && (booking().customerId == request.auth.uid || booking().partnerId == request.auth.uid);
      }

      function chatOpen() {
        return booking().status in ['Requested', 'Active', 'On the way'];
      }

      function validNewMessage(data) {
        return data.keys().hasAll(['senderId', 'text', 'createdAt'])
          && data.keys().hasOnly(['senderId', 'text', 'createdAt'])
          && data.senderId == request.auth.uid
          && data.text is string && data.text.size() > 0 && data.text.size() <= 2000
          && data.createdAt == request.time;
      }

      allow get: if isParticipant();
      allow list: if isParticipant();

      allow create: if isParticipant() && chatOpen() && validNewMessage(request.resource.data);
      allow update: if false;
      allow delete: if false;
    }

    /**
     * @description Allows a user to read/write their own notifications.
     * @path /notifications/{notificationId}
     * @allow (create) request.auth.uid == 'user_abc' and request.resource.data.userId == 'user_abc'
     * @allow (get, update, delete) request.auth.uid == 'user_abc'
     * @deny (create) request.auth.uid != 'user_abc'
     * @deny (get, update, delete) request.auth.uid != 'user_abc'
     * @principle Enforces document ownership for writes.
     */
    match /notifications/{notificationId} {
      // Ownership comes from the stored document's userId field.
      // (The previous version called isOwner(request.auth.uid), which compares the
      // caller's uid with itself and therefore let ANY signed-in user read, edit or
      // delete ANY notification.)
      function isStoredOwner() {
        return request.auth != null && resource != null && resource.data.userId == request.auth.uid;
      }

      allow get: if isStoredOwner();
      allow list: if false;

      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      // The owner may update their notification but cannot hand it to another user.
      allow update: if isStoredOwner() && request.resource.data.userId == resource.data.userId;
      allow delete: if isStoredOwner();
    }
  }
}