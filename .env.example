# Copy to .env.local and fill in. .env* files are git-ignored (this example is the exception).

# Google Maps Geocoding API key (used to turn the user's GPS position into an address).
# Restrict it to your domains in Google Cloud Console.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Firebase web config is in src/firebase/config.ts (public identifiers, protected by
# firestore.rules). On Firebase App Hosting, initializeApp() reads it automatically.

# Local testing only: use the Firebase Auth/Firestore emulators instead of the real project.
NEXT_PUBLIC_USE_FIREBASE_EMULATORS=false
